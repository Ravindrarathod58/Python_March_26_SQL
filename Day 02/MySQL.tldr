						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\t\tWe can store the long strings , more than one lines in text datatype"
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
