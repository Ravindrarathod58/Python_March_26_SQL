							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "ENUM(‘ADMIN’, ‘USER’)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
