											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "CHAR(length)"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\t\twe can store the collection of character of fixed size "
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 5,
