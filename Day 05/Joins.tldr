		{
			"x": 510.72003173828125,
			"y": 41.602505683898926,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:RHCH4khOJxFCRGeDQA_UK",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 202.60000610351562,
				"font": "mono",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1.5405531400311006,
				"richText": {
					"type": "doc",
					"attrs": {
