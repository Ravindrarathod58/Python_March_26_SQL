								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The indexes improves the performance of the select and join quries but comes with drawbacks"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "→ The indexes makes the insert / delete / update operation slower"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\tbecause every time when the new record is inserted , deletes or updated then it has to update the"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "  indexes thats why these operations becomes slow"
								}
							]
						}
					]
				}
			},
