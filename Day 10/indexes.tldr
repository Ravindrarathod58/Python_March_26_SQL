							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t4. get all the coding problems for the student 1;"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t5. get the all subtopics, assignments and assignment questions (MCQs , coding)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
