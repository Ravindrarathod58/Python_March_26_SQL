								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "UNION"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\t\tunion is keyword which merge two or more than two queries"
								}
							]
						}
					]
				}
			},
