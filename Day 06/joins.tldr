											},
											"content": [
												{
													"type": "text",
													"text": "foreign key"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\t\t- It used to refer the table that has the primary key and related data "
								}
							]
						},
