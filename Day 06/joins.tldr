											},
											"content": [
												{
													"type": "text",
													"text": "unique key"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "   -  same as the primary key but can store the null values"
